# Salesforce MCP Server Configuration
# OAuth 2.0 Connected App credentials (Username-Password flow)
SALESFORCE_CLIENT_ID=your_connected_app_client_id
SALESFORCE_CLIENT_SECRET=your_connected_app_client_secret
SALESFORCE_USERNAME=your_salesforce_username@example.com
SALESFORCE_PASSWORD=your_salesforce_password_plus_security_token
SALESFORCE_INSTANCE_URL=https://yourinstance.salesforce.com

# Optional: use sandbox instead of production
# SALESFORCE_LOGIN_URL=https://test.salesforce.com

# Transport (optional — default: stdio)
# MCP_TRANSPORT=http
# MCP_HTTP_PORT=3000
